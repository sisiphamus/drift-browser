{
  "name": "drift-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Drift: a fast, agent-native workspace browser for Linux. For those who can't find the browser best for them.",
  "main": "out/main/index.js",
  "type": "module",
  "bin": {
    "drift": "bin/drift.mjs"
  },
  "scripts": {
    "postinstall": "node scripts/fetch-fonts.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "e2e": "electron-vite build && vitest run -c vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "cross-fetch": "^4.1.0",
    "electron-chrome-extensions": "^4.9.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.6.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/sisiphamus/drift-browser"
  },
  "homepage": "https://sisiphamus.github.io/drift-browser/"
}
